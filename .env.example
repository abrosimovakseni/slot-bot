# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file -- it's already in .gitignore.

# Telegram bot token from @BotFather (Telegram -> search "BotFather" -> /mybot -> API Token).
BOT_TOKEN=

# PostgreSQL connection string.
# Locally (see README for how to run Postgres on your machine):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slot_dev
# On Railway: leave this blank in your local .env and instead set it as an
# environment variable in the Railway service -- Railway's own PostgreSQL
# plugin provides this value automatically as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# Optional: your own numeric Telegram user id. If set, the bot will send you
# a message whenever it hits an unexpected error, so problems in production
# don't go unnoticed. Get your id by messaging @userinfobot on Telegram.
ADMIN_ID=

# Optional: how often (in seconds) the bot re-checks the database as a
# safety net, on top of the precise Wed/Fri 09:30 triggers. Default: 900
# (15 minutes). You normally don't need to change this.
RECONCILE_INTERVAL_SECONDS=900
