{
  "name": "slot-bot-cf",
  "version": "1.0.0",
  "private": true,
  "description": "SLOT Telegram bot -- Cloudflare Workers + D1 + Queues + Cron Triggers edition (free-tier architecture).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply slot_bot_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply slot_bot_db --remote",
    "set-webhook": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260903.1": true
  }
}
